# Normalize line endings: LF in the repository and on checkout, so scripts and
# generated JSON Schemas behave the same on Windows, macOS and Linux CI.
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts and the Gradle wrapper script must keep LF, or they fail on Linux and macOS.
gradlew text eol=lf
*.sh text eol=lf

# Binary files: never touch or diff as text.
*.jar binary
*.pdf binary
*.png binary
*.wasm binary
*.so binary
*.dll binary
*.dylib binary

# Conformance cases must keep their bytes (CRLF, byte order marks, ...): never normalize them.
conformance/** -text
