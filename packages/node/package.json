{
  "name": "@pamoda2004/msgkit",
  "version": "0.2.0",
  "description": "Import SMS, WhatsApp and Messenger messages and calls into one normalized model. Portable WebAssembly build; no native addons.",
  "keywords": [
    "sms",
    "whatsapp",
    "messenger",
    "facebook",
    "import",
    "chat-export",
    "webhook",
    "wasm"
  ],
  "license": "MIT",
  "author": "Pamoda Jayathilaka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pamoda2004/msgkit.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/pamoda2004/msgkit#readme",
  "bugs": {
    "url": "https://github.com/pamoda2004/msgkit/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./msgkit.wasm": "./dist/msgkit.wasm",
    "./package.json": "./package.json"
  },
  "imports": {
    "#load": {
      "node": "./src/load-node.js",
      "default": "./src/load-browser.js"
    }
  },
  "files": [
    "src",
    "dist/msgkit.wasm",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/msgkit.test.mjs test/conformance.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
